{
	"files.readonlyInclude": {
		"**/routeTree.gen.ts": true,
		"**/.tanstack/**/*": true,
		"pnpm-lock.yaml": true
	},
	"files.watcherExclude": {
		"**/routeTree.gen.ts": true,
		"**/.tanstack/**/*": true,
		"pnpm-lock.yaml": true
	},
	"search.exclude": {
		"**/routeTree.gen.ts": true,
		"**/.tanstack/**/*": true,
		"pnpm-lock.yaml": true
	},

	// use LF line endings
	"files.eol": "\n",

	// disable prettier, eslint, biome
	"prettier.enable": false,
	"eslint.enable": false,
	"biome.enabled": false,
	// enable oxlint + oxfmt
	"oxc.enable": true,

	// oxfmt via vite+
	"oxc.fmt.configPath": "./vite.config.ts",

	// set oxfmt as default formatter
	"editor.defaultFormatter": "oxc.oxc-vscode",

	// format on save and paste
	"editor.formatOnSave": true,
	"editor.formatOnPaste": true,

	// vite+ for npm scripts
	"npm.scriptRunner": "vp"
}
